{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/tools-copy",
      "destination": "/c3-crm",
      "permanent": true
    },
    {
      "source": "/studio",
      "destination": "/c3-studio-cicd",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/c3-studio-core",
      "permanent": true
    },
    {
      "source": "/compass-new",
      "destination": "/compass",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
